{% doc %}
  @prompt
    Create a slideshow block with settings to fit the slideshow on desktop and mobile versions. , Add setting to add or remove extra slides, I want to be able to add more than 3 slide if needed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-slideshow-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;position:relative;overflow:hidden;background:{{ block.settings.background_color }}}.ai-slideshow-{{ ai_gen_id }}__viewport{position:relative;height:{{ block.settings.desktop_height }}px}.ai-slideshow-{{ ai_gen_id }}__slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden}.ai-slideshow-{{ ai_gen_id }}__slide.is-active{opacity:1;visibility:visible;z-index:1}.ai-slideshow-{{ ai_gen_id }}__media,.ai-slideshow-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:{{ block.settings.image_fit }}}.ai-slideshow-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:{{ block.settings.background_color }}}.ai-slideshow-{{ ai_gen_id }}__placeholder svg{width:40%;height:40%;opacity:.4}.ai-slideshow-{{ ai_gen_id }}__overlay{position:absolute;inset:0;background:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }}}.ai-slideshow-{{ ai_gen_id }}__content{position:relative;z-index:2;width:min(100% - 48px,720px);padding:32px 24px;text-align:{{ block.settings.text_alignment }};color:{{ block.settings.text_color }}}.ai-slideshow-{{ ai_gen_id }}__heading{margin:0 0 12px;color:{{ block.settings.text_color }};font-size:{{ block.settings.heading_size }}px}.ai-slideshow-{{ ai_gen_id }}__text{margin:0 0 20px;color:{{ block.settings.text_color }}}.ai-slideshow-{{ ai_gen_id }}__button{display:inline-flex;padding:10px 22px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};text-decoration:none}.ai-slideshow-{{ ai_gen_id }}__controls{position:absolute;z-index:3;right:20px;bottom:20px;left:20px;display:flex;justify-content:space-between;align-items:center}.ai-slideshow-{{ ai_gen_id }}__nav{width:40px;height:40px;border:1px solid {{ block.settings.control_color }};border-radius:50%;background:{{ block.settings.control_background }};color:{{ block.settings.control_color }};cursor:pointer}.ai-slideshow-{{ ai_gen_id }}__dots{display:flex;gap:8px;position:absolute;left:50%;transform:translateX(-50%)}.ai-slideshow-{{ ai_gen_id }}__dot{width:10px;height:10px;padding:0;border:1px solid {{ block.settings.control_color }};border-radius:50%;background:transparent;cursor:pointer}.ai-slideshow-{{ ai_gen_id }}__dot.is-active{background:{{ block.settings.control_color }}}@media screen and (max-width:749px){.ai-slideshow-{{ ai_gen_id }}{width:100%}.ai-slideshow-{{ ai_gen_id }}__viewport{height:{{ block.settings.mobile_height }}px}.ai-slideshow-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}}{% endstyle %}
<slideshow-{{ ai_gen_id }} class="ai-slideshow-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-slideshow-{{ ai_gen_id }}__viewport">{% for i in (1..6) %}{% if i <= block.settings.slide_count %}{% liquid
assign image_key = 'slide_' | append: i | append: '_image'
assign heading_key = 'slide_' | append: i | append: '_heading'
assign text_key = 'slide_' | append: i | append: '_text'
assign link_key = 'slide_' | append: i | append: '_link'
assign label_key = 'slide_' | append: i | append: '_label'
assign image = block.settings[image_key]
assign heading = block.settings[heading_key]
assign text = block.settings[text_key]
assign link = block.settings[link_key]
assign label = block.settings[label_key]
%}<div class="ai-slideshow-{{ ai_gen_id }}__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">{% if image != blank %}<img class="ai-slideshow-{{ ai_gen_id }}__media" src="{{ image | image_url: width:2400 }}" alt="{{ image.alt | escape }}" loading="lazy">{% else %}<div class="ai-slideshow-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-slideshow-{{ ai_gen_id }}__overlay"></div><div class="ai-slideshow-{{ ai_gen_id }}__content">{% if heading != blank %}<h2 class="ai-slideshow-{{ ai_gen_id }}__heading">{{ heading | escape }}</h2>{% endif %}{% if text != blank %}<div class="ai-slideshow-{{ ai_gen_id }}__text">{{ text }}</div>{% endif %}{% if link != blank and label != blank %}<a class="ai-slideshow-{{ ai_gen_id }}__button" href="{{ link }}">{{ label | escape }}</a>{% endif %}</div></div>{% endif %}{% endfor %}<div class="ai-slideshow-{{ ai_gen_id }}__controls"><button class="ai-slideshow-{{ ai_gen_id }}__nav" type="button" data-direction="previous" aria-label="Previous slide">&#8592;</button><div class="ai-slideshow-{{ ai_gen_id }}__dots">{% for i in (1..6) %}{% if i <= block.settings.slide_count %}<button class="ai-slideshow-{{ ai_gen_id }}__dot{% if forloop.first %} is-active{% endif %}" type="button" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>{% endif %}{% endfor %}</div><button class="ai-slideshow-{{ ai_gen_id }}__nav" type="button" data-direction="next" aria-label="Next slide">&#8594;</button></div></div></slideshow-{{ ai_gen_id }}>
<script>(function(){class S{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.s=[...this.querySelectorAll('[data-slide]')];this.d=[...this.querySelectorAll('[data-index]')];this.i=0;this.querySelector('[data-direction="previous"]').onclick=()=>this.show(this.i-1);this.querySelector('[data-direction="next"]').onclick=()=>this.show(this.i+1);this.d.forEach(x=>x.onclick=()=>this.show(+x.dataset.index))}show(i){this.i=(i+this.s.length)%this.s.length;this.s.forEach((x,n)=>{x.classList.toggle('is-active',n===this.i);x.setAttribute('aria-hidden',n===this.i?'false':'true')});this.d.forEach((x,n)=>x.classList.toggle('is-active',n===this.i))}}if(!customElements.get('slideshow-{{ ai_gen_id }}'))customElements.define('slideshow-{{ ai_gen_id }}',S{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Responsive slideshow","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_height","label":"Desktop height","min":250,"max":900,"step":10,"unit":"px","default":560},{"type":"range","id":"mobile_height","label":"Mobile height","min":220,"max":700,"step":10,"unit":"px","default":480},{"type":"range","id":"slide_count","label":"Number of slides","min":1,"max":6,"step":1,"default":3},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Fill area"},{"value":"contain","label":"Show full image"}],"default":"cover"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"image_picker","id":"slide_1_image","label":"Slide 1 image"},{"type":"text","id":"slide_1_heading","label":"Slide 1 heading","default":"Built for the call"},{"type":"textarea","id":"slide_1_text","label":"Slide 1 text","default":"Professional gear and uniforms for teams who serve."},{"type":"url","id":"slide_1_link","label":"Slide 1 link"},{"type":"text","id":"slide_1_label","label":"Slide 1 button","default":"Shop now"},{"type":"image_picker","id":"slide_2_image","label":"Slide 2 image"},{"type":"text","id":"slide_2_heading","label":"Slide 2 heading","default":"Ready for every shift"},{"type":"textarea","id":"slide_2_text","label":"Slide 2 text","default":"Dependable essentials for department teams."},{"type":"url","id":"slide_2_link","label":"Slide 2 link"},{"type":"text","id":"slide_2_label","label":"Slide 2 button","default":"Explore gear"},{"type":"image_picker","id":"slide_3_image","label":"Slide 3 image"},{"type":"text","id":"slide_3_heading","label":"Slide 3 heading","default":"Equip your department"},{"type":"textarea","id":"slide_3_text","label":"Slide 3 text","default":"Create a storefront designed around your department."},{"type":"url","id":"slide_3_link","label":"Slide 3 link"},{"type":"text","id":"slide_3_label","label":"Slide 3 button","default":"Get started"},{"type":"image_picker","id":"slide_4_image","label":"Slide 4 image"},{"type":"text","id":"slide_4_heading","label":"Slide 4 heading","default":"Slide four"},{"type":"textarea","id":"slide_4_text","label":"Slide 4 text","default":"Add your slide content here."},{"type":"url","id":"slide_4_link","label":"Slide 4 link"},{"type":"text","id":"slide_4_label","label":"Slide 4 button","default":"Learn more"},{"type":"image_picker","id":"slide_5_image","label":"Slide 5 image"},{"type":"text","id":"slide_5_heading","label":"Slide 5 heading","default":"Slide five"},{"type":"textarea","id":"slide_5_text","label":"Slide 5 text","default":"Add your slide content here."},{"type":"url","id":"slide_5_link","label":"Slide 5 link"},{"type":"text","id":"slide_5_label","label":"Slide 5 button","default":"Learn more"},{"type":"image_picker","id":"slide_6_image","label":"Slide 6 image"},{"type":"text","id":"slide_6_heading","label":"Slide 6 heading","default":"Slide six"},{"type":"textarea","id":"slide_6_text","label":"Slide 6 text","default":"Add your slide content here."},{"type":"url","id":"slide_6_link","label":"Slide 6 link"},{"type":"text","id":"slide_6_label","label":"Slide 6 button","default":"Learn more"},{"type":"color","id":"background_color","label":"Background","default":"#1e2262"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"overlay_color","label":"Overlay","default":"#212326"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":25},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":72,"step":2,"unit":"px","default":48},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":20,"max":52,"step":2,"unit":"px","default":34},{"type":"color","id":"button_color","label":"Button","default":"#ffffff"},{"type":"color","id":"button_text_color","label":"Button text","default":"#1a1b18"},{"type":"color","id":"control_background","label":"Controls background","default":"#1e2262"},{"type":"color","id":"control_color","label":"Controls","default":"#ffffff"}],"presets":[{"name":"Responsive slideshow"}],"tag":null,"class":"responsive-slideshow-block"}{% endschema %}