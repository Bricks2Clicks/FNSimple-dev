{%- if predictive_search.performed -%}
  {%- assign first_column_results_size = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size | plus: predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size -%}
  <div
    id="predictive-search__results-list"
    class="predictive-search-results{% if predictive_search.resources.products.size == 0 and predictive_search.resources.queries.size == 0 and predictive_search.resources.collections.size == 0 and predictive_search.resources.pages.size == 0 %} is-empty{% endif %}"
    role="listbox">
    {%- if first_column_results_size > 0 or predictive_search.resources.products.size > 0 or predictive_search.resources.collections.size > 0 or predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
      {%- if first_column_results_size > 0 or predictive_search.resources.products.size > 0 -%}
        <div
          id="predictive-search-results-groups-wrapper"
          class="predictive-search__results-groups-wrapper
          {% unless predictive_search.resources.products.size > 0 %}
            predictive-search__results-groups-wrapper--no-products{% endunless %}
          {% unless predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 %}
            predictive-search__results-groups-wrapper--no-suggestions
          {% endunless %}">
        {%- endif -%}
        {%- if first_column_results_size > 0 -%}
          <div class="predictive-search__result-group">
          {%- endif -%}
          {%- if predictive_search.resources.queries.size > 0 or predictive_search.resources.collections.size > 0 -%}
            <div>
              <h2 id="predictive-search-queries" class="predictive-search__heading h4">
                {{- 'templates.search.suggestions' | t -}}
              </h2>
              <ul
                id="predictive-search-results-queries-list"
                class="predictive-search__results-list list-unstyled list-text--links"
                role="group"
                aria-labelledby="predictive-search-queries">
                {%- for query in predictive_search.resources.queries -%}
                  <li
                    id="predictive-search-option-query-{{ forloop.index }}"
                    class="predictive-search__list-item"
                    role="option"
                    aria-selected="false">
                    <a
                      href="{{ query.url }}"
                      class="predictive-search__item predictive-search__item--link link link--text"
                      tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading predictive-search__item-query-result h5" aria-label="{{ query.text }}">{{ query.styled_text }}</p>
                      </div>
                    </a>
                  </li>
                {%- endfor -%}
                {%- comment %}<locksmith:ecf4>{% endcomment -%}
                  {%- assign locksmith_671e_forloop__size = 0 %}{%- for collection in predictive_search.resources.collections -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: collection, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_671e_forloop__size = locksmith_671e_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_671e_forloop__index = nil -%}
                {%- comment %}</locksmith:ecf4>{% endcomment -%}
                {%- for collection in predictive_search.resources.collections -%}
                  {%- comment %}<locksmith:a394>{% endcomment -%}
                    {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: collection, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_671e_forloop__index == nil %}{% assign locksmith_671e_forloop__index = 1 %}{% assign locksmith_671e_forloop__index0 = 0 %}{% else %}{% assign locksmith_671e_forloop__index = locksmith_671e_forloop__index | plus: 1 %}{% assign locksmith_671e_forloop__index0 = locksmith_671e_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_671e_forloop__index == 1 %}{% assign locksmith_671e_forloop__first = true %}{% else %}{% assign locksmith_671e_forloop__first = false %}{% endif %}{% if locksmith_671e_forloop__index == locksmith_671e_forloop__size %}{% assign locksmith_671e_forloop__last = true %}{% else %}{% assign locksmith_671e_forloop__last = false %}{% endif %}{% assign locksmith_671e_forloop__rindex = locksmith_671e_forloop__size | minus: locksmith_671e_forloop__index | minus: 1 %}{% assign locksmith_671e_forloop__rindex0 = locksmith_671e_forloop__size | minus: locksmith_671e_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                  {%- comment %}</locksmith:a394>{% endcomment -%}
                  <li
                    id="predictive-search-option-collection-{{ locksmith_671e_forloop__index }}"
                    class="predictive-search__list-item"
                    role="option"
                    aria-selected="false">
                    <a
                      href="{{ collection.url }}"
                      class="predictive-search__item predictive-search__item--link link link--text"
                      tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">{{ collection.title }}</p>
                      </div>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
            <div class="predictive-search__pages-wrapper">
              <h2 id="predictive-search-pages-desktop" class="predictive-search__heading h4">
                {{- 'templates.search.pages' | t -}}
              </h2>
              <ul
                id="predictive-search-results-pages-list-desktop"
                class="predictive-search__results-list list-unstyled list-text--links"
                role="group"
                aria-labelledby="predictive-search-pages-desktop">
                {%- for page in predictive_search.resources.pages -%}
                  <li
                    id="predictive-search-option-page-desktop-{{ forloop.index }}"
                    class="predictive-search__list-item"
                    role="option"
                    aria-selected="false">
                    <a
                      href="{{ page.url }}"
                      class="predictive-search__item predictive-search__item--link link link--text"
                      tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">{{ page.title }}</p>
                      </div>
                    </a>
                  </li>
                {%- endfor -%}
                {%- comment %}<locksmith:db1d>{% endcomment -%}
                  {%- assign locksmith_804d_forloop__size = 0 %}{%- for article in predictive_search.resources.articles -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: article, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_804d_forloop__size = locksmith_804d_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_804d_forloop__index = nil -%}
                {%- comment %}</locksmith:db1d>{% endcomment -%}
                {%- for article in predictive_search.resources.articles -%}
                  {%- comment %}<locksmith:2a81>{% endcomment -%}
                    {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: article, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_804d_forloop__index == nil %}{% assign locksmith_804d_forloop__index = 1 %}{% assign locksmith_804d_forloop__index0 = 0 %}{% else %}{% assign locksmith_804d_forloop__index = locksmith_804d_forloop__index | plus: 1 %}{% assign locksmith_804d_forloop__index0 = locksmith_804d_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_804d_forloop__index == 1 %}{% assign locksmith_804d_forloop__first = true %}{% else %}{% assign locksmith_804d_forloop__first = false %}{% endif %}{% if locksmith_804d_forloop__index == locksmith_804d_forloop__size %}{% assign locksmith_804d_forloop__last = true %}{% else %}{% assign locksmith_804d_forloop__last = false %}{% endif %}{% assign locksmith_804d_forloop__rindex = locksmith_804d_forloop__size | minus: locksmith_804d_forloop__index | minus: 1 %}{% assign locksmith_804d_forloop__rindex0 = locksmith_804d_forloop__size | minus: locksmith_804d_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                  {%- comment %}</locksmith:2a81>{% endcomment -%}
                  <li
                    id="predictive-search-option-article-desktop-{{ locksmith_804d_forloop__index }}"
                    class="predictive-search__list-item"
                    role="option"
                    aria-selected="false">
                    <a
                      href="{{ article.url }}"
                      class="predictive-search__item predictive-search__item--link link link--text"
                      tabindex="-1">
                      <div class="predictive-search__item-content predictive-search__item-content--centered">
                        <p class="predictive-search__item-heading h5">{{ article.title }}</p>
                      </div>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if first_column_results_size > 0 -%}
          </div>
        {%- endif -%}

        {%- if predictive_search.resources.products.size > 0 or predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
          <div class="predictive-search__result-group">
            {%- if predictive_search.resources.products.size > 0 -%}
              <div>
                <h2 id="predictive-search-products" class="predictive-search__heading h4">
                  {{- 'templates.search.products' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-products-list"
                  class="predictive-search__results-list list-unstyled"
                  role="group"
                  aria-labelledby="predictive-search-products">
                  {%- comment %}<locksmith:e78d>{% endcomment -%}
                    {%- assign locksmith_19a9_forloop__size = 0 %}{%- for product in predictive_search.resources.products -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: product, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_19a9_forloop__size = locksmith_19a9_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_19a9_forloop__index = nil -%}
                  {%- comment %}</locksmith:e78d>{% endcomment -%}
                  {%- for product in predictive_search.resources.products -%}
                    {%- comment %}<locksmith:0cfb>{% endcomment -%}
                      {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: product, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_19a9_forloop__index == nil %}{% assign locksmith_19a9_forloop__index = 1 %}{% assign locksmith_19a9_forloop__index0 = 0 %}{% else %}{% assign locksmith_19a9_forloop__index = locksmith_19a9_forloop__index | plus: 1 %}{% assign locksmith_19a9_forloop__index0 = locksmith_19a9_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_19a9_forloop__index == 1 %}{% assign locksmith_19a9_forloop__first = true %}{% else %}{% assign locksmith_19a9_forloop__first = false %}{% endif %}{% if locksmith_19a9_forloop__index == locksmith_19a9_forloop__size %}{% assign locksmith_19a9_forloop__last = true %}{% else %}{% assign locksmith_19a9_forloop__last = false %}{% endif %}{% assign locksmith_19a9_forloop__rindex = locksmith_19a9_forloop__size | minus: locksmith_19a9_forloop__index | minus: 1 %}{% assign locksmith_19a9_forloop__rindex0 = locksmith_19a9_forloop__size | minus: locksmith_19a9_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                    {%- comment %}</locksmith:0cfb>{% endcomment -%}
                    <li
                      id="predictive-search-option-{{ locksmith_19a9_forloop__index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false">
                      <a
                        href="{{ product.url }}"
                        class="predictive-search__item predictive-search__item--link link link--text"
                        tabindex="-1">
                        {%- if product.featured_media != blank -%}
                          <div>
                            <span class="predictive-search__image media-wrapper media-wrapper--small">
                              <div class="media media--adapt" style="--image-ratio-percent: {{ 1 | divided_by: product.featured_media.aspect_ratio | times: 100 }}%;">
                                <img
                                  srcset="{{ product.featured_media | image_url: width: 70 }} 1x, {{ product.featured_media | image_url: width: 140 }} 2x"
                                  src="{{ product.featured_media | image_url: width: 70 }}"
                                  alt="{{ product.featured_media.alt }}"
                                  width="70"
                                  height="{{ 70 | divided_by: product.featured_media.preview_image.aspect_ratio }}"
                                  loading="lazy"
                                  is="lazy-image" />
                              </div>
                            </span>
                          </div>
                        {%- endif -%}
                        <div class="predictive-search__item-content">
                          {%- if settings.predictive_search_show_vendor -%}
                            <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
                            <div class="predictive-search__item-vendor card-article-info caption-with-letter-spacing">{{ product.vendor }}</div>
                          {%- endif -%}
                          <span class="predictive-search__item-heading h4">{{ product.title }}</span>
                          {%- if settings.predictive_search_show_price -%}
                            {% render 'price', product: product %}
                          {%- endif -%}
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
            {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
              <div class="predictive-search__pages-wrapper">
                <h2 id="predictive-search-pages-mobile" class="predictive-search__heading h4">
                  {{- 'templates.search.pages' | t -}}
                </h2>
                <ul
                  id="predictive-search-results-pages-list-mobile"
                  class="predictive-search__results-list list-unstyled list-text--links"
                  role="group"
                  aria-labelledby="predictive-search-pages-mobile">
                  {%- for page in predictive_search.resources.pages -%}
                    <li
                      id="predictive-search-option-page-mobile-{{ forloop.index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false">
                      <a
                        href="{{ page.url }}"
                        class="predictive-search__item predictive-search__item--link link link--text"
                        tabindex="-1">
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ page.title }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                  {%- comment %}<locksmith:085d>{% endcomment -%}
                    {%- assign locksmith_cd5c_forloop__size = 0 %}{%- for article in predictive_search.resources.articles -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: article, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_cd5c_forloop__size = locksmith_cd5c_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_cd5c_forloop__index = nil -%}
                  {%- comment %}</locksmith:085d>{% endcomment -%}
                  {%- for article in predictive_search.resources.articles -%}
                    {%- comment %}<locksmith:b738>{% endcomment -%}
                      {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: article, subject_parent: predictive_search.resources, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_cd5c_forloop__index == nil %}{% assign locksmith_cd5c_forloop__index = 1 %}{% assign locksmith_cd5c_forloop__index0 = 0 %}{% else %}{% assign locksmith_cd5c_forloop__index = locksmith_cd5c_forloop__index | plus: 1 %}{% assign locksmith_cd5c_forloop__index0 = locksmith_cd5c_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_cd5c_forloop__index == 1 %}{% assign locksmith_cd5c_forloop__first = true %}{% else %}{% assign locksmith_cd5c_forloop__first = false %}{% endif %}{% if locksmith_cd5c_forloop__index == locksmith_cd5c_forloop__size %}{% assign locksmith_cd5c_forloop__last = true %}{% else %}{% assign locksmith_cd5c_forloop__last = false %}{% endif %}{% assign locksmith_cd5c_forloop__rindex = locksmith_cd5c_forloop__size | minus: locksmith_cd5c_forloop__index | minus: 1 %}{% assign locksmith_cd5c_forloop__rindex0 = locksmith_cd5c_forloop__size | minus: locksmith_cd5c_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                    {%- comment %}</locksmith:b738>{% endcomment -%}
                    <li
                      id="predictive-search-option-article-mobile-{{ locksmith_cd5c_forloop__index }}"
                      class="predictive-search__list-item"
                      role="option"
                      aria-selected="false">
                      <a
                        href="{{ article.url }}"
                        class="predictive-search__item predictive-search__item--link link link--text"
                        tabindex="-1">
                        <div class="predictive-search__item-content predictive-search__item-content--centered">
                          <p class="predictive-search__item-heading h5">{{ article.title }}</p>
                        </div>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if first_column_results_size > 0 or predictive_search.resources.products.size > 0 -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="title-wrapper center">
        <p class="title h3 title--primary">{{ 'templates.search.no_results' | t: terms: predictive_search.terms }}</p>
        <p class="typeset">{{ 'templates.search.check_the_spelling' | t }}</p>
      </div>
    {%- endif -%}

    <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button">
      <button
        class="predictive-search__item predictive-search__item--term button button--small button--full-width"
        tabindex="-1"
        role="option"
        aria-selected="false">
        <span data-predictive-search-search-for-text class="text">{{ 'templates.search.search_for' | t: terms: predictive_search.terms }}</span>
      </button>
    </div>
  </div>
  <span class="hidden" data-predictive-search-live-region-count-value>
    {% liquid
      assign total_results = predictive_search.resources.products.size | plus: first_column_results_size
      if total_results == 0
        echo 'templates.search.no_results' | t: terms: predictive_search.terms
      else
        echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
        if predictive_search.resources.queries.size > 0
          assign count = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size
          echo 'templates.search.results_suggestions_with_count' | t: count: count | append: ', '
        endif
        if predictive_search.resources.pages.size > 0
          assign count = predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
          echo 'templates.search.results_pages_with_count' | t: count: count | append: ', '
        endif
        if predictive_search.resources.products.size > 0
          echo 'templates.search.results_products_with_count' | t: count: predictive_search.resources.products.size
        endif
      endif
    %}
  </span>
{%- endif -%}