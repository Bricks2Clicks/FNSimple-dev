{%- liquid
  unless limit
    assign limit = menu.links.size
  endunless
  unless offset
    assign offset = 0
  endunless
-%}

<nav class="header__inline-menu{% if offset > 0 %} header__inline-menu-split{% endif %}">
  <ul class="list-menu list-menu--inline" role="list">
    {%- comment %}<locksmith:d503>{% endcomment -%}
      {%- assign locksmith_97f9_forloop__size = 0 %}{%- for link in menu.links limit: limit offset: offset -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: menu, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_97f9_forloop__size = locksmith_97f9_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_97f9_forloop__index = nil -%}
    {%- comment %}</locksmith:d503>{% endcomment -%}
    {%- for link in menu.links limit: limit offset: offset -%}
      {%- comment %}<locksmith:2dfb>{% endcomment -%}
        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: menu, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_97f9_forloop__index == nil %}{% assign locksmith_97f9_forloop__index = 1 %}{% assign locksmith_97f9_forloop__index0 = 0 %}{% else %}{% assign locksmith_97f9_forloop__index = locksmith_97f9_forloop__index | plus: 1 %}{% assign locksmith_97f9_forloop__index0 = locksmith_97f9_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_97f9_forloop__index == 1 %}{% assign locksmith_97f9_forloop__first = true %}{% else %}{% assign locksmith_97f9_forloop__first = false %}{% endif %}{% if locksmith_97f9_forloop__index == locksmith_97f9_forloop__size %}{% assign locksmith_97f9_forloop__last = true %}{% else %}{% assign locksmith_97f9_forloop__last = false %}{% endif %}{% assign locksmith_97f9_forloop__rindex = locksmith_97f9_forloop__size | minus: locksmith_97f9_forloop__index | minus: 1 %}{% assign locksmith_97f9_forloop__rindex0 = locksmith_97f9_forloop__size | minus: locksmith_97f9_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
      {%- comment %}</locksmith:2dfb>{% endcomment -%}
      {%- liquid
        assign enable_mega_menu = false
        if enable_dropdown_menu
          assign link_title_handle = link.title | downcase | handle

          for block in blocks
            assign menu_title_handle = block.settings.menu_title | downcase | handle
            if menu_title_handle == link_title_handle
              assign enable_mega_menu = true
              assign mega_menu_block = block
              break
            endif
          endfor
        endif
      -%}
      <li>
        {%- if link.links != blank -%}
          {%- if enable_dropdown_menu -%}
            {%- if enable_mega_menu -%}
              {% render 'mega-menu', link: link, block: mega_menu_block, enable_highlight: enable_highlight, highlight_labels: highlight_labels, highlight_style: highlight_style %}
            {%- else -%}
              <dropdown-menu>
                <a href="{{ link.url }}" class="header__menu-item{% if link.active or link.child_active %} header__active-menu-item{% endif %} header__menu-item--top list-menu__item focus-inset">
                  {%- liquid
                    assign item_title = link.title | escape
                    if enable_highlight and highlight_labels contains item_title
                      render 'highlight-text', hl_input: item_title, hl_phrases: highlight_labels, hl_style: highlight_style, hl_animateWrap: true
                    else
                      echo '<span class="label">'
                      echo item_title
                      echo '</span>'
                    endif
                    render 'icon', icon: 'caret' 
                  -%}
                </a>
                <div class="list-menu-dropdown hidden">
                  <ul class="list-menu" role="list" tabindex="-1">
                    {%- for childlink in link.links -%}
                      {%- comment %}<locksmith:627d>{% endcomment -%}
                        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: childlink, subject_parent: link, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                      {%- comment %}</locksmith:627d>{% endcomment -%}
                      <li>
                        {%- if childlink.links == blank -%}
                          <dropdown-menu>
                            <a href="{{ childlink.url }}" class="header__menu-item list-menu__item focus-inset{% if childlink.current %} list-menu__item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                              <span class="label">{{ childlink.title | escape }}</span>
                            </a>
                          </dropdown-menu>
                        {%- else -%}
                          <dropdown-menu>
                            <a href="{{ childlink.url }}" class="header__menu-item{% if childlink.active or childlink.child_active %} header__active-menu-item{% endif %} list-menu__item focus-inset">
                              <span class="label">{{ childlink.title | escape }}</span>
                              {% render 'icon', icon: 'caret' %}
                            </a>
                            <div class="list-menu-dropdown hidden">
                              <ul class="list-menu" role="list" tabindex="-1">
                                {%- for grandchildlink in childlink.links -%}
                                  {%- comment %}<locksmith:d070>{% endcomment -%}
                                    {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: grandchildlink, subject_parent: childlink, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                                  {%- comment %}</locksmith:d070>{% endcomment -%}
                                  <li>
                                    <a href="{{ grandchildlink.url }}" class="header__menu-item list-menu__item focus-inset{% if grandchildlink.current %} list-menu__item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                      <span class="label">{{ grandchildlink.title | escape }}</span>
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          </dropdown-menu>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </dropdown-menu>
            {%- endif -%}
          {%- else -%}
            <menu-drawer>
              <details>
                <summary class="header__menu-item{% if link.active or link.child_active %} header__active-menu-item{% endif %} header__menu-item--top list-menu__item focus-inset">
                  <span class="label">{{ link.title | escape }}</span>
                  {% render 'icon', icon: 'caret' %}
                </summary>
                <div class="list-menu-drawer motion-reduce">
                  <ul class="header__submenu list-menu list-menu--disclosure" role="list" tabindex="-1">
                    {%- comment %}<locksmith:7fb4>{% endcomment -%}
                      {%- assign locksmith_bc20_forloop__size = 0 %}{%- for childlink in link.links -%}{% capture var %}{% render 'locksmith-variables', scope: 'subject', subject: childlink, subject_parent: link, variable: 'transparent' %}{% endcapture %}{% if var == 'true' %}{% assign locksmith_bc20_forloop__size = locksmith_bc20_forloop__size | plus: 1 %}{% endif %}{% endfor %}{% assign locksmith_bc20_forloop__index = nil -%}
                    {%- comment %}</locksmith:7fb4>{% endcomment -%}
                    {%- for childlink in link.links -%}
                      {%- comment %}<locksmith:8bf6>{% endcomment -%}
                        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: childlink, subject_parent: link, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% if locksmith_bc20_forloop__index == nil %}{% assign locksmith_bc20_forloop__index = 1 %}{% assign locksmith_bc20_forloop__index0 = 0 %}{% else %}{% assign locksmith_bc20_forloop__index = locksmith_bc20_forloop__index | plus: 1 %}{% assign locksmith_bc20_forloop__index0 = locksmith_bc20_forloop__index0 | plus: 1 %}{% endif %}{% if locksmith_bc20_forloop__index == 1 %}{% assign locksmith_bc20_forloop__first = true %}{% else %}{% assign locksmith_bc20_forloop__first = false %}{% endif %}{% if locksmith_bc20_forloop__index == locksmith_bc20_forloop__size %}{% assign locksmith_bc20_forloop__last = true %}{% else %}{% assign locksmith_bc20_forloop__last = false %}{% endif %}{% assign locksmith_bc20_forloop__rindex = locksmith_bc20_forloop__size | minus: locksmith_bc20_forloop__index | minus: 1 %}{% assign locksmith_bc20_forloop__rindex0 = locksmith_bc20_forloop__size | minus: locksmith_bc20_forloop__index0 | minus: 1 %}{% else %}{% continue %}{% endif -%}
                      {%- comment %}</locksmith:8bf6>{% endcomment -%}
                      <li data-animate data-animate-delay-{{ locksmith_bc20_forloop__index }}>
                        {%- if childlink.links == blank -%}
                          {%- if childlink.type == 'collection_link' -%}
                            <list-menu-item data-title="{{ childlink.title | escape }}" data-url="{{ childlink.url }}" data-image="{% if childlink.object.image %}{{ childlink.object.image | image_url: width: 460 }}{% endif %}" data-description="{{ childlink.object.description | strip_html | truncatewords: 30 }}">
                          {%- endif -%}
                              <a href="{{ childlink.url }}" class="header__menu-item list-menu__item focus-inset{% if childlink.current %} list-menu__item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                <span class="label">{{ childlink.title | escape }}</span>
                              </a>
                          {%- if childlink.type == 'collection_link' -%}
                            </list-menu-item>
                          {%- endif -%}
                        {%- else -%}
                          <details>
                            <summary>
                              {%- if childlink.type == 'collection_link' -%}
                                <list-menu-item data-title="{{ childlink.title | escape }}" data-url="{{ childlink.url }}" data-image="{% if childlink.object.image %}{{ childlink.object.image | image_url: width: 460 }}{% endif %}" data-description="{{ childlink.object.description | strip_html | truncatewords: 30 }}">
                              {%- endif -%}
                                  <div class="header__menu-item{% if childlink.active or childlink.child_active %} header__active-menu-item{% endif %} list-menu__item focus-inset">
                                    <span class="label">{{ childlink.title | escape }}</span>
                                    {% render 'icon', icon: 'caret' %}
                                  </div>
                              {%- if childlink.type == 'collection_link' -%}
                                </list-menu-item>
                              {%- endif -%}
                            </summary>
                            <ul class="header__submenu list-menu list-chilmenu--disclosure motion-reduce">
                              {%- for grandchildlink in childlink.links -%}
                                {%- comment %}<locksmith:4a04>{% endcomment -%}
                                  {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: grandchildlink, subject_parent: childlink, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                                {%- comment %}</locksmith:4a04>{% endcomment -%}
                                <li>
                                  {%- if grandchildlink.type == 'collection_link' -%}
                                    <list-menu-item data-title="{{ grandchildlink.title | escape }}" data-url="{{ grandchildlink.url }}" data-image="{% if grandchildlink.object.image %}{{ grandchildlink.object.image | image_url: width: 460 }}{% endif %}" data-description="{{ grandchildlink.object.description | strip_html | truncatewords: 30 }}">
                                  {%- endif -%}
                                      <a href="{{ grandchildlink.url }}" class="header__menu-item list-menu__item focus-inset{% if grandchildlink.current %} list-menu__item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                        <span class="label">{{ grandchildlink.title | escape }}</span>
                                      </a>
                                  {%- if grandchildlink.type == 'collection_link' -%}
                                    </list-menu-item>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                  <list-menu-hover class="list-menu__hover"></list-menu-hover>
                </div>
              </details>
            </menu-drawer>
          {%- endif -%}
        {%- else -%}
          {%- if enable_mega_menu -%}
            {% render 'mega-menu', link: link, block: mega_menu_block, enable_highlight: enable_highlight, highlight_labels: highlight_labels, highlight_style: highlight_style %}
          {%- else -%}
            <dropdown-menu>
              <a href="{{ link.url }}" class="header__menu-item{% if link.current %} header__active-menu-item{% endif %} header__menu-item--top list-menu__item focus-inset"{% if link.current %} aria-current="page"{% endif %}>
                {%- liquid
                  assign item_title = link.title | escape
                  if enable_highlight and highlight_labels contains item_title
                    render 'highlight-text', hl_input: item_title, hl_phrases: highlight_labels, hl_style: highlight_style, hl_animateWrap: true
                  else
                    echo '<span class="label">'
                    echo item_title
                    echo '</span>'
                  endif
                -%}
              </a>
            </dropdown-menu>
          {%- endif -%}
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
