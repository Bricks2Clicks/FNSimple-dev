{%- comment -%}
  FNS split-ship: mixed-cart shipping prompt (Be Yours 8.1.1).
  Rendered once from layout/theme.liquid before </body>.
  The fee VARIANT id lives in snippets/split-ship-fee-id.liquid.
{%- endcomment -%}
{%- capture split_ship_variant_id -%}{%- render 'split-ship-fee-id' -%}{%- endcapture -%}
{%- assign split_ship_variant_id = split_ship_variant_id | strip | plus: 0 -%}

{%- liquid
  assign fn_has_week = false
  assign fn_has_nonstock = false
  for item in cart.items
    if item.variant_id == split_ship_variant_id
      continue
    endif
    assign fn_vendor = item.vendor | strip | downcase
    if fn_vendor == 'one week item'
      assign fn_has_week = true
    endif
    if fn_vendor == 'non stock item'
      assign fn_has_nonstock = true
    endif
  endfor
  assign fn_pref = cart.attributes['Shipment preference']
  assign fn_needs_choice = false
  if fn_has_week and fn_has_nonstock
    unless fn_pref == 'Split shipping' or fn_pref == 'Ship together'
      assign fn_needs_choice = true
    endunless
  endif
-%}

<style>
  :root {
    --fn-split-navy: #1E2262;
    --fn-split-text: #212326;
    --fn-split-font: var(--font-body-family, Poppins, sans-serif);
  }
  .fn-split-ship-dialog {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
  }
  .fn-split-ship-dialog.is-open {
    display: flex;
  }
  .fn-split-ship-dialog__backdrop {
    display: block !important;
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 20, 0.55);
  }
  .fn-split-ship-dialog__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 520px;
    max-height: 92vh;
    overflow: auto;
    background: #fff;
    color: var(--fn-split-text);
    font-family: var(--fn-split-font);
    font-size: 16px;
    padding: 24px 20px 28px;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.18);
  }
  @media (min-width: 750px) {
    .fn-split-ship-dialog {
      align-items: center;
      padding: 24px;
    }
    .fn-split-ship-dialog__panel {
      border-radius: 12px;
      padding: 28px 28px 24px;
    }
  }
  .fn-split-ship-dialog__title {
    margin: 0 0 8px;
    font-family: var(--fn-split-font);
    font-size: 21px;
    line-height: 1.3;
    color: var(--fn-split-text);
  }
  .fn-split-ship-dialog__lead,
  .fn-split-ship-dialog__prompt {
    margin: 0 0 16px;
    font-family: var(--fn-split-font);
    font-size: 15px;
    line-height: 1.45;
    color: var(--fn-split-text);
  }
  .fn-split-ship-dialog__prompt {
    font-weight: 650;
    margin-bottom: 12px;
  }
  .fn-split-ship-dialog__options {
    display: grid;
    gap: 12px;
    margin: 0 0 20px;
  }
  .fn-split-ship-dialog__option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 12px;
    align-items: start;
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--fn-split-navy);
    border-radius: 8px;
    font-family: var(--fn-split-font);
    font-size: 16px;
    color: var(--fn-split-text);
    cursor: pointer;
  }
  .fn-split-ship-dialog__option:has(input:checked) {
    box-shadow: inset 0 0 0 1px var(--fn-split-navy);
  }
  .fn-split-ship-dialog__option:has(input:focus-visible) {
    outline: 2px solid var(--fn-split-navy);
    outline-offset: 2px;
  }
  .fn-split-ship-dialog__option input {
    margin: 3px 0 0;
    width: 18px;
    height: 18px;
    accent-color: var(--fn-split-navy);
  }
  .fn-split-ship-dialog__option-title {
    font-weight: 650;
  }
  .fn-split-ship-dialog__option-help {
    grid-column: 2;
    font-size: 14px;
    line-height: 1.4;
    color: var(--fn-split-text);
  }
  .fn-split-ship-dialog__error {
    display: none;
    margin: 0 0 16px;
    padding: 10px 12px;
    background: #fdecec;
    color: var(--fn-split-text);
    font-family: var(--fn-split-font);
    font-size: 14px;
  }
  .fn-split-ship-dialog__error.is-visible {
    display: block;
  }
  .fn-split-ship-dialog__submit {
    width: 100%;
    min-height: 44px;
    padding: 12px 16px;
    border: 1px solid var(--fn-split-navy);
    border-radius: 6px;
    background: var(--fn-split-navy);
    color: #fff;
    font-family: var(--fn-split-font);
    font-size: 16px;
    cursor: pointer;
  }
  .fn-split-ship-dialog__submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .fn-split-ship-status {
    display: grid;
    gap: 6px 16px;
    align-items: center;
    width: 100%;
    margin: 0 0 16px;
    padding: 14px 16px;
    border: 1px solid var(--fn-split-navy);
    border-radius: 8px;
    background: #fff;
    color: var(--fn-split-text);
    font-family: var(--fn-split-font);
    box-sizing: border-box;
    text-align: left;
  }
  .fn-split-ship-status[hidden] {
    display: none !important;
  }
  @media (min-width: 750px) {
    .fn-split-ship-status {
      grid-template-columns: 1fr auto;
    }
  }
  .fn-split-ship-status__title {
    margin: 0;
    font-weight: 650;
    font-family: var(--fn-split-font);
    font-size: 15px;
    color: var(--fn-split-text);
  }
  .fn-split-ship-status__text {
    margin: 0;
    font-family: var(--fn-split-font);
    font-size: 14px;
    line-height: 1.4;
    color: var(--fn-split-text);
    grid-column: 1;
  }
  .fn-split-ship-status__change {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--fn-split-navy);
    border-radius: 6px;
    background: var(--fn-split-navy);
    color: #fff;
    font-family: var(--fn-split-font);
    font-size: 14px;
    cursor: pointer;
  }
  .fn-split-ship-status__change:hover {
    opacity: 0.9;
  }
  @media (min-width: 750px) {
    .fn-split-ship-status__change {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  .mini-cart__footer .fn-split-ship-status {
    margin: 16px 0;
    grid-template-columns: 1fr;
  }
  .mini-cart__footer .fn-split-ship-status__change {
    grid-column: 1;
    grid-row: auto;
    justify-self: start;
    margin-top: 6px;
  }
  body.fn-split-ship-hide-wallets shopify-accelerated-checkout-cart,
  body.fn-split-ship-hide-wallets .additional-checkout-buttons,
  body.fn-split-ship-hide-wallets .cart__dynamic-checkout-buttons {
    display: none !important;
  }
  [data-fn-split-ship-fee] quantity-input,
  [data-fn-split-ship-fee] quantity-popover,
  [data-fn-split-ship-fee] cart-remove-button {
    display: none !important;
  }
  .fn-split-ship-fee-qty {
    font-size: 14px;
  }
</style>
{%- if fn_needs_choice %}
  <style id="fn-split-ship-wallets-ssr">
    shopify-accelerated-checkout-cart,
    .additional-checkout-buttons,
    .cart__dynamic-checkout-buttons {
      display: none !important;
    }
  </style>
{%- endif %}

<div
  id="fn-split-ship-dialog"
  class="fn-split-ship-dialog"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="fn-split-ship-title"
  aria-describedby="fn-split-ship-lead"
>
  <div class="fn-split-ship-dialog__backdrop"></div>
  <div class="fn-split-ship-dialog__panel" role="document">
    <h2 id="fn-split-ship-title" class="fn-split-ship-dialog__title">Your cart contains items with different shipping timelines.</h2>
    <p id="fn-split-ship-lead" class="fn-split-ship-dialog__lead">
      Some items ship within one week. Others are made as quickly as possible, without a guaranteed ship date.
    </p>
    <form id="fn-split-ship-form">
      <p id="fn-split-ship-prompt" class="fn-split-ship-dialog__prompt">Choose your shipping preference:</p>
      <div class="fn-split-ship-dialog__options" role="radiogroup" aria-labelledby="fn-split-ship-prompt">
        <label class="fn-split-ship-dialog__option">
          <input type="radio" name="fn-split-ship-choice" value="split">
          <span class="fn-split-ship-dialog__option-title">Split Shipping (+$5)</span>
          <span class="fn-split-ship-dialog__option-help">Ship one-week items separately, without waiting for the other items.</span>
        </label>
        <label class="fn-split-ship-dialog__option">
          <input type="radio" name="fn-split-ship-choice" value="together">
          <span class="fn-split-ship-dialog__option-title">Ship Together (Free)</span>
          <span class="fn-split-ship-dialog__option-help">Ship everything together when all items are ready.</span>
        </label>
      </div>
      <p id="fn-split-ship-error" class="fn-split-ship-dialog__error" role="alert"></p>
      <button type="submit" class="fn-split-ship-dialog__submit" id="fn-split-ship-submit" disabled>Continue</button>
    </form>
  </div>
</div>

<template id="fn-split-ship-status-template">
  <div class="fn-split-ship-status" data-fn-split-ship-status>
    <p class="fn-split-ship-status__title" data-fn-split-ship-status-title></p>
    <p class="fn-split-ship-status__text" data-fn-split-ship-status-text></p>
    <button type="button" class="fn-split-ship-status__change" data-fn-split-ship-change>
      Change shipping preference
    </button>
  </div>
</template>

<script type="application/json" id="fn-split-ship-config">
  {
    "feeVariantId": {{ split_ship_variant_id | json }},
    "vendors": {
      "oneWeek": "One Week Item",
      "nonStock": "Non Stock Item"
    },
    "attributeKey": "Shipment preference",
    "values": {
      "split": "Split shipping",
      "together": "Ship together"
    },
    "copy": {
      "split": {
        "title": "Shipping: Split Shipping (+$5)",
        "text": "Ship one-week items separately, without waiting for the other items."
      },
      "together": {
        "title": "Shipping: Ship Together (Free)",
        "text": "Ship everything together when all items are ready."
      }
    }
  }
</script>

<script src="{{ 'split-ship.js' | asset_url }}" defer></script>
