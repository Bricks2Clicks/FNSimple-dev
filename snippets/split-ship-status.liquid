{%- comment -%}
  FNS split-ship: cart confirmation of the shipment preference, with a Change button.
  Rendered in sections/mini-cart.liquid (drawer footer) and sections/main-cart-footer.liquid (cart page).
  assets/split-ship.js updates the text or hides it after cart changes.
{%- endcomment -%}
{%- capture fee_variant_id -%}{%- render 'split-ship-fee-id' -%}{%- endcapture -%}
{%- assign fee_variant_id = fee_variant_id | strip | plus: 0 -%}
{%- assign has_week = false -%}
{%- assign has_nonstock = false -%}
{%- for item in cart.items -%}
  {%- if item.variant_id == fee_variant_id -%}
    {%- continue -%}
  {%- endif -%}
  {%- assign vendor = item.vendor | strip | downcase -%}
  {%- if vendor == 'one week item' -%}{%- assign has_week = true -%}{%- endif -%}
  {%- if vendor == 'non stock item' -%}{%- assign has_nonstock = true -%}{%- endif -%}
{%- endfor -%}
{%- assign pref = cart.attributes['Shipment preference'] -%}
{%- if has_week and has_nonstock -%}
  {%- if pref == 'Split shipping' or pref == 'Ship together' -%}
    <div class="fn-split-ship-status" data-fn-split-ship-status>
      {%- if pref == 'Split shipping' -%}
        <p class="fn-split-ship-status__title" data-fn-split-ship-status-title>Shipping: Get my 1-week items first</p>
        <p class="fn-split-ship-status__text" data-fn-split-ship-status-text>Two shipments - $5 extra</p>
      {%- else -%}
        <p class="fn-split-ship-status__title" data-fn-split-ship-status-title>Shipping: Wait and ship everything together</p>
        <p class="fn-split-ship-status__text" data-fn-split-ship-status-text>One shipment - no extra charge</p>
      {%- endif -%}
      <button type="button" class="fn-split-ship-status__change" data-fn-split-ship-change>
        Change shipping preference
      </button>
    </div>
  {%- endif -%}
{%- endif -%}
